<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SilOS</title>
    <style>
      body { font-family: system-ui, sans-serif; margin: 2rem; color: #18212f; }
      #silos-apps { max-width: 44rem; }
      .silos-app { margin-bottom: 2rem; }
      .silos-ui-state { color: #52606d; }
      .silos-template-list { padding-left: 1.4rem; }
      .silos-template-list li { margin: .65rem 0; }
      .silos-template-field, .silos-template-literal { display: block; }
    </style>
  </head>
  <body>
    <main id="silos-apps" aria-live="polite">
      <p class="silos-ui-state" data-state="booting">Starting SilOS…</p>
    </main>
    <script>
      // The runtime remains the source of UI state; this loader only starts it.
      var Module = {};
    </script>
    <script src="./silos-todo-boot.js"></script>
  </body>
</html>
